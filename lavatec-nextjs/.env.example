# Copy this file to .env.local and fill in the values
# NOTE: Client-side variables must be prefixed with NEXT_PUBLIC_

# API base URL (used by src/utils/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps API key (used by logistics maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional app metadata
NEXT_PUBLIC_APP_NAME=Lavatec
NEXT_PUBLIC_APP_DESCRIPTION=Laundry Management System
NEXT_PUBLIC_ENVIRONMENT=development
